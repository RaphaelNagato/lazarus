{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lazarus.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Lazarus.Api/bin/Debug/net10.0/Lazarus.Api.dll",
      "cwd": "${workspaceFolder}/src/Lazarus.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/healthz"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5027",
        "BUILD_VERSION": "local-dev",
        "FAIL_MODE": "false"
      }
    },
    {
      "name": "Lazarus.Api (FAIL_MODE)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Lazarus.Api/bin/Debug/net10.0/Lazarus.Api.dll",
      "cwd": "${workspaceFolder}/src/Lazarus.Api",
      "stopAtEntry": false,
      "console": "internalConsole",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/healthz"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5027",
        "BUILD_VERSION": "local-bad",
        "FAIL_MODE": "true"
      }
    }
  ]
}
